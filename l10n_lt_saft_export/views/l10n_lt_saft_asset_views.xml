<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="l10n_lt_saft_asset_list" model="ir.ui.view">
        <field name="name">l10n_lt.saft.asset.list</field>
        <field name="model">l10n_lt.saft.asset</field>
        <field name="arch" type="xml">
            <list string="SAF-T Assets">
                <field name="code"/>
                <field name="name"/>
                <field name="account_id"/>
                <field name="acquisition_date"/>
                <field name="start_date"/>
                <field name="acquisition_value" sum="Total"/>
                <field name="useful_life_months"/>
                <field name="disposal_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="l10n_lt_saft_asset_form" model="ir.ui.view">
        <field name="name">l10n_lt.saft.asset.form</field>
        <field name="model">l10n_lt.saft.asset</field>
        <field name="arch" type="xml">
            <form string="SAF-T Asset">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Delivery van"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="registration_number"/>
                            <field name="valuation_class"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Accounting">
                            <field name="account_id"/>
                            <field name="depreciation_account_id"/>
                            <field name="acquisition_move_id"/>
                            <field name="disposal_move_id"/>
                        </group>
                        <group string="Valuation">
                            <field name="acquisition_date"/>
                            <field name="start_date"/>
                            <field name="acquisition_value"/>
                            <field name="useful_life_months"/>
                            <field name="disposal_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_lt_saft_asset_search" model="ir.ui.view">
        <field name="name">l10n_lt.saft.asset.search</field>
        <field name="model">l10n_lt.saft.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="account_id"/>
                <filter name="in_use" string="In use" domain="[('disposal_date', '=', False)]"/>
                <filter name="disposed" string="Disposed" domain="[('disposal_date', '!=', False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_lt_saft_asset" model="ir.actions.act_window">
        <field name="name">SAF-T Assets</field>
        <field name="res_model">l10n_lt.saft.asset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a fixed asset</p>
            <p>Assets registered here are reported in the SAF-T parts "Assets" and "Asset transactions".</p>
        </field>
    </record>
</odoo>
