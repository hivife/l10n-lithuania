<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_journal_form_inherit_l10n_lt_saft" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.l10n_lt_saft</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="l10n_lt_saft_journal_type" invisible="country_code != 'LT'"/>
            </xpath>
        </field>
    </record>
</odoo>
