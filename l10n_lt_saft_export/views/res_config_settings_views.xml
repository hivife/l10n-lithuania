<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_lt_saft" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n_lt_saft</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='fiscal_localization_setting_container']" position="after">
                <block title="SAF-T Lithuania" name="l10n_lt_saft_setting_container" invisible="country_code != 'LT'">
                    <setting id="l10n_lt_saft_settings" string="SAF-T Export" company_dependent="1"
                             help="Header data of the Lithuanian SAF-T file.">
                        <div class="content-group">
                            <div class="row mt-2">
                                <label for="l10n_lt_saft_entity" class="col-lg-5 o_light_label"/>
                                <field name="l10n_lt_saft_entity"/>
                            </div>
                            <div class="row">
                                <label for="l10n_lt_saft_tax_accounting_basis" class="col-lg-5 o_light_label"/>
                                <field name="l10n_lt_saft_tax_accounting_basis"/>
                            </div>
                            <div class="row">
                                <label for="l10n_lt_saft_contact_id" class="col-lg-5 o_light_label"/>
                                <field name="l10n_lt_saft_contact_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
